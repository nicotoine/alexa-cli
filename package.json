{
  "name": "alexa-cli",
  "version": "0.2.0",
  "description": "Alexa smart-home devices and voice routines from the command line (unofficial Alexa API)",
  "keywords": [
    "alexa",
    "echo",
    "routines",
    "smart-home",
    "cli"
  ],
  "author": "nicotoine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicotoine/alexa-cli.git"
  },
  "type": "module",
  "bin": {
    "alexa-cli": "bin/alexa-cli.js"
  },
  "files": [
    "bin",
    "src",
    "interface",
    "install.sh",
    "install-completion.sh"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\" \"interface/test/**/*.test.js\"",
    "ui": "node interface/server/index.js",
    "ui:build": "npm --prefix interface/app ci --no-audit --no-fund && npm --prefix interface/app run build",
    "ui:dev": "npm --prefix interface/app run dev",
    "surface:update": "node test/update-surface.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "alexa-remote2": "^8.1.1"
  }
}
