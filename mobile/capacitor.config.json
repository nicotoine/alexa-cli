{
  "appId": "io.github.nicotoine.alexacli",
  "appName": "Alexa",
  "webDir": "www",
  "server": {
    "cleartext": true,
    "allowNavigation": ["127.0.0.1", "*.amazon.fr", "*.amazon.com", "*.amazon.de"]
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "CapacitorNodeJS": {
      "nodeDir": "nodejs",
      "startMode": "auto"
    }
  }
}
